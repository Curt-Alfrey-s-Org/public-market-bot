[Unit]
Description=Market Pie5 Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=operator
Group=operator
WorkingDirectory=/home/operator/market-bot/market-pie5-bot

# Environment file
EnvironmentFile=/home/operator/market-bot/market-pie5-bot/.env

# Main executable
ExecStart=/usr/bin/python3 /home/operator/market-bot/market-pie5-bot/main.py

# Restart policy
Restart=on-failure
RestartSec=30
StartLimitInterval=300
StartLimitBurst=5

# Resource limits
LimitNOFILE=65536
Nice=0

# Logging
StandardOutput=append:/home/operator/market-bot/market-pie5-bot/logs/systemd.log
StandardError=append:/home/operator/market-bot/market-pie5-bot/logs/systemd_error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/operator/market-bot/market-pie5-bot

# Graceful shutdown
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
