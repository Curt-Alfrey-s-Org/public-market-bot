# Environment Configuration Template
# Copy this file to .env and fill in your actual values
#
# USER-CONFIGURABLE (set here or via Web GUI Settings):
#   Capital & risk: BOT_TOTAL_CAPITAL, BOT_MIN/MAX_ALLOCATION, BOT_POSITION_SIZE, BOT_MAX_OPEN_POSITIONS,
#                   BOT_RISK_THRESHOLD, BOT_STOP_LOSS_PERCENT, BOT_TAKE_PROFIT_PERCENT, USE_MARGIN
#   Modes: PAPER_TRADING_MODE, DRY_RUN_MODE, MANUAL_TRADE_APPROVAL_MODE, BACKTEST_MODE, SCHWAB_SANDBOX_MODE
#   Alerts: ALERT_EMAIL_ENABLED (and SMTP_* below if enabled)
#   Advanced: TRADING_FREQUENCY, LOG_LEVEL, DEBUG, EXIT_REFRESH_PRICE
# BOT-MANAGED (do not set in Settings; defaults or set by Dashboard when starting):
#   SCHWAB_API_ENABLED (set by Dashboard mode: Live/Sandbox/Training/Dry-run)
#   Throttling/performance: TOP_PERFORMERS_REFRESH_INTERVAL, ASYNC_REQUEST_TIMEOUT, BOT_MAX_CPU_PERCENT, etc.
#
# WHAT AFFECTS WHAT (see docs/ENV_SIMPLIFICATION.md for details):
#   Paper vs Live     -> PAPER_TRADING_MODE, SCHWAB_SANDBOX_MODE (or use Web GUI mode buttons)
#   Which stocks      -> MIN/MAX_STOCK_PRICE, MIN_DAILY_VOLUME, MAX_STOCK_VOLATILITY
#   How many to trade -> MAX_STOCKS_TO_SCAN, TOP_STOCKS_TO_TRADE, MAX_DISCOVERED_STOCKS
#   Order types       -> BOT_DEFAULT_BUY_ORDER_TYPE, BOT_DEFAULT_SELL_ORDER_TYPE
#   Risk              -> BOT_RISK_THRESHOLD, BOT_POSITION_SIZE, BOT_STOP_LOSS_PERCENT
#   Shorts            -> ALLOW_SHORTS_IN_PAPER, SCHWAB_SHORT_SELLING_ENABLED, MAX_SHORT_*

# ============================================================================
# 0. DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
# PostgreSQL Database Connection
# Production (from Docker container): postgresql://marketbot_user@postgres:5432/marketbot
# Development (from host): postgresql://marketbot_user@localhost:5435/marketbot
# SQLite fallback (not recommended): sqlite:///./bot_auth.db
DATABASE_URL=postgresql://marketbot_user@postgres:5432/marketbot

# PostgreSQL Database Credentials (used by docker-compose)
POSTGRES_DB=marketbot
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me

# Docker Compose: match host deploy user for API bind mounts (data, logs, bot_state.json).
# When using docker compose, generate .env.compose-host-user via scripts/export_compose_uid_gid.sh; set manually if you run compose without that flow.
# HOST_UID=1000
# HOST_GID=1000

# Database Connection Pool Settings
# Adjust based on expected concurrent users and available database connections
DB_POOL_SIZE=10              # Base pool size (default: 10)
DB_MAX_OVERFLOW=20           # Additional connections when pool is full (default: 20)
DB_POOL_TIMEOUT=30           # Seconds to wait for connection from pool (default: 30)
DB_POOL_RECYCLE=3600         # Recycle connections after N seconds (default: 3600 = 1 hour)

# ============================================================================
# 1. SCHWAB API & AUTH
# ============================================================================
# Schwab API Keys and Authentication
# Get these from developer.schwab.com after creating an app
# SETUP GUIDE: See SCHWAB_API_SETUP_GUIDE.md for complete walkthrough

# API Credentials (NEVER commit these to git!)
SCHWAB_API_KEY=change-me
SCHWAB_APP_SECRET=change-me

# OAuth Configuration
# Callback URL must EXACTLY match your Schwab app settings
# Default: https://127.0.0.1:8182/callback
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/callback

# Account Configuration
SCHWAB_ACCOUNT_ID=your_account_number

# Schwab Mode Selection
# true = Sandbox (simulated trading, sandbox API endpoints)
# false = Production (REAL MONEY, production API endpoints)
SCHWAB_SANDBOX_MODE=true

# Token Management
# Token file path for OAuth credentials (created automatically on first auth)
SCHWAB_TOKEN_PATH=token.json

# Token Encryption (Enhanced Security - RECOMMENDED)
# Set to 'false' to disable token encryption (not recommended)
# When enabled, token.json will be encrypted with Fernet and protected by HMAC
SCHWAB_ENCRYPT_TOKEN=true

# Encryption key for token file (optional - will use MP5_ENCRYPTION_KEY if not set)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Alternatively, create a .token.key or .env.key file with the key
# This key is auto-generated on first run if not provided
# SCHWAB_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# General encryption key for environment variables and tokens
# MP5_ENCRYPTION_KEY=your_fernet_key_here

# Key Rotation (Security Feature)
# Set to 'true' to rotate encryption keys (generates new key and overwrites old one)
# IMPORTANT: Previously encrypted values will not be decryptable after rotation
# Back up your old key before rotating if you need to decrypt old values
# The flag is automatically cleared after successful rotation
# MP5_ROTATE_ENCRYPTION_KEY=false

# OAuth Flow Settings
# Timeout for OAuth authorization flow (seconds)
SCHWAB_AUTH_TIMEOUT=300

# Non-Interactive Mode (for CI/CD, automated scripts, cron jobs, systemd)
# Set to 'true' when running bot in environments without stdin/stdout
# When true: Requires token.json to exist OR SCHWAB_API_ENABLED=off
# When false: Can prompt for OAuth login interactively
# Production deployment with systemd: Set to 'true'
NON_INTERACTIVE=false

# SCHWAB_API_ENABLED: Set automatically by mode selection (Live/Sandbox/Training/Dry-run).
# Do not set here. Default is 'on' when unset; Training mode sets 'off'.
# Optional override only if not using Web GUI mode selection:
# SCHWAB_API_ENABLED=on

# Schwab API Rate Limiting
# Market data endpoint limits (calls per minute)
SCHWAB_MARKET_DATA_LIMIT=120
# Account/trading endpoint limits (calls per minute)
SCHWAB_TRADING_LIMIT=60
# Safety margin to stay under limits (0.8 = 80% of limit)
SCHWAB_RATE_LIMIT_MARGIN=0.8

# ============================================================================
# Optional LLM gateway (OpenAI-compatible LiteLLM proxy)
# ----------------------------------------------------------------------------
# Set LITELLM_ENABLED=false and BOT_REQUIRE_BRAIN=false to run paper trading
# without any LLM service. See docs/ENV_VARS.md when enabling AI features.
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=change-me
# Model aliases (must exist on your LiteLLM proxy)
LITELLM_MODEL_CHAT=app-chat
LITELLM_MODEL_PAGE_QUESTION=app-chat
LITELLM_MODEL_INTERNAL=code
LITELLM_TIMEOUT=600

# Require LLM gateway reachability before starting the trader.
# false -> paper trading works without LiteLLM (recommended for first run).
BOT_REQUIRE_BRAIN=false

# LLM narratives (journal, performance summary) — not parameter tuning
BOT_LLM_INSIGHTS_ENABLED=true
# How often the running loop re-probes brain health (0 disables mid-run re-checks)
BOT_BRAIN_CHECK_INTERVAL_SECONDS=60
# Timeout for each brain liveliness probe (seconds)
BOT_BRAIN_CHECK_TIMEOUT_SECONDS=10

# Optional per-trust-zone keys (else LITELLM_API_KEY is used for all)
# LITELLM_API_KEY_APP=
# LITELLM_API_KEY_INTERNAL=

# Automatic error monitoring (optional LLM triage when LiteLLM is enabled)
ERROR_MONITOR_ENABLED=true
# Seconds between background triage batches
ERROR_MONITOR_INTERVAL_SECONDS=600
# Max errors triaged per batch
ERROR_MONITOR_BATCH_SIZE=1

# Opt-in fine-tune capture (DISABLED by default). When true, redacted
# (prompt -> completion) pairs are stored in finetune_samples for later export.
FINETUNE_CAPTURE_ENABLED=false
# Days to retain captured samples before purge
FINETUNE_RETENTION_DAYS=30

# Alpha Vantage API (for fundamental data: P/E ratios, earnings, etc.)
# Get free API key at: https://www.alphavantage.co/support/#api-key
# Free tier: 5 API calls/minute, 500/day
ALPHA_VANTAGE_API_KEY=change-me

# Alpha Vantage Rate Limiting Configuration
# Maximum API calls per minute for Alpha Vantage (free tier default: 5)
ALPHA_VANTAGE_MAX_CALLS_PER_MINUTE=5
# Time window for Alpha Vantage rate limiting in seconds (default: 60)
ALPHA_VANTAGE_TIME_WINDOW_SECONDS=60

# yfinance Rate Limiting Configuration
# Maximum API calls per minute for yfinance (recommended: 30)
# Note: yfinance doesn't have official rate limits but this prevents overwhelming the service
YFINANCE_MAX_CALLS_PER_MINUTE=30
# Time window for yfinance rate limiting in seconds (default: 60)
YFINANCE_TIME_WINDOW_SECONDS=60

# Market Data Provider Selection
# Select market data provider for quotes (historical data continues to use yfinance)
# Options: 'YAHOOQUERY' (fast multi-quote) or 'YFINANCE' (fallback)
# Default: 'YAHOOQUERY'
MARKET_DATA_PROVIDER=YAHOOQUERY

# yahooquery Rate Limiting Configuration (used when MARKET_DATA_PROVIDER=YAHOOQUERY)
# Maximum API calls per minute for yahooquery batch quotes (recommended: 60)
YAHOOQUERY_MAX_CALLS_PER_MINUTE=60
# Time window for yahooquery rate limiting in seconds (default: 60)
YAHOOQUERY_TIME_WINDOW_SECONDS=60

# Asynchronous Data Fetching Configuration
# Enable concurrent API requests for faster data retrieval
# When enabled, the bot fetches data from multiple APIs simultaneously
# Schwab API remains top priority for buy/sell/account operations
# Default: 'true'
ENABLE_ASYNC_FETCHING=true
# Maximum concurrent API requests (optimize for Raspberry Pi 5)
# Lower values reduce resource usage but may slow down data fetching
# Recommended: 5 for Pi 5, 3-5 for older hardware
# Default: 5
ASYNC_MAX_CONCURRENT_REQUESTS=5
# Request timeout in seconds for async operations
# Default: 10
ASYNC_REQUEST_TIMEOUT=10

# News API for Sentiment Analysis (optional)
# Get free API key at: https://newsapi.org
# Free tier: 100 requests/day
NEWS_API_KEY=change-me

# News API Rate Limiting Configuration
# Maximum API calls per day for NewsAPI (free tier default: 100)
NEWS_API_MAX_CALLS_PER_DAY=100
# Time window for NewsAPI rate limiting in hours (default: 24)
NEWS_API_TIME_WINDOW_HOURS=24

# Finnhub API for Financial News (alternative/supplement to NewsAPI)
# Get free API key at: https://finnhub.io
# Free tier: 60 API calls/minute
FINNHUB_API_KEY=change-me

# Finnhub Rate Limiting Configuration
# Maximum API calls per minute for Finnhub (free tier default: 60)
FINNHUB_MAX_CALLS_PER_MINUTE=60
# Time window for Finnhub rate limiting in seconds (default: 60)
FINNHUB_TIME_WINDOW_SECONDS=60

# Sentiment Analysis Method ('vader' or 'textblob')
SENTIMENT_METHOD=vader

# ============================================================================
# 2. TRADING MODE
# ============================================================================
# IMPORTANT: These are DEFAULT values. Web GUI mode buttons override them per session.
# When using the Web GUI, select a mode (Sandbox/Live/Training) on the homepage BEFORE starting the bot
# The mode selection will automatically configure these parameters for that session
# Set to 'true' for paper trading (simulation), 'false' for live trading
PAPER_TRADING_MODE=true

# Dry-Run Mode for Live Trading Validation
# Set to 'true' to validate live trading workflow without executing actual trades
# When enabled:
#   - All validations (credentials, risk checks, capital floor) are performed
#   - Order payloads are constructed and logged
#   - API authentication is tested
#   - NO actual orders are placed on Schwab
# Use this for end-to-end testing before going live
# Default: 'false'
DRY_RUN_MODE=false

# Manual Trade Approval Mode
# Set to 'true' to require user approval before executing trades
# When enabled:
#   - Bot identifies trades and creates pending trade requests
#   - Shows full trade details, reasoning, and what would happen in auto mode
#   - User approves/rejects each trade via GUI
#   - Trades only execute after approval
# Use this to learn bot decision-making and build trust before full automation
# Default: 'false'
MANUAL_TRADE_APPROVAL_MODE=false

# Backtesting Mode
# WARNING: This is a testing-only mode - do not use for live trading!
# Set to 'true' to run in backtesting mode using historical data (1 year by default)
# When enabled:
#   - Bot loads historical data and simulates trades to evaluate strategy performance
#   - Results are saved to backtest_history.json
#   - No real-time market data or actual trades are executed
#   - Useful for testing strategies before deploying them
# Set to 'false' for normal operation (live or paper trading)
# Default: 'false'
BACKTEST_MODE=false

# Schwab API Sandbox Mode
# IMPORTANT: This is a DEFAULT value that can be overridden by the Web GUI mode selection
# When using the Web GUI, the mode buttons automatically configure this parameter
# Set to 'true' to use Schwab's sandbox environment for testing with real-time API calls
# Set to 'false' to use production environment (requires valid production credentials)
# Note: In the Web GUI Settings tab, there's also an 'off' option which disables Schwab API
#       entirely and uses yfinance for training mode. This is equivalent to setting
#       SCHWAB_API_ENABLED=off.
# When PAPER_TRADING_MODE=true and SCHWAB_SANDBOX_MODE=true: Uses sandbox API instead of simulation
# When PAPER_TRADING_MODE=false: Sandbox mode is ignored and production API is used
SCHWAB_SANDBOX_MODE=true

# Random Price Fallback Configuration
# Set to 'true' to allow random price generation when yfinance also fails
# Set to 'false' to raise error instead of using random prices
# ONLY applies in pure simulation or API disabled modes (NOT sandbox or live)
# Sandbox and live modes NEVER use fallback regardless of this setting
# Default: 'true'
ALLOW_RANDOM_FALLBACK=true

# Bot Configuration Settings
# Total capital for paper/sim/training modes. In live production mode, if USE_SCHWAB_CAPITAL_IN_LIVE=true,
# this value is fetched from the Schwab API (account cash/buying power) instead of using this config.
# Use 10000 for dry-run/paper; use 1000 (or less) when first going live. See LIVE_MODE_GUIDE.md § Capital & Sizing.
BOT_TOTAL_CAPITAL=10000
# In live production mode, fetch capital from Schwab API account funds (cash/buying power).
# Set to 'true' to use actual account funds; 'false' to use BOT_TOTAL_CAPITAL config value.
# Default: 'true' (recommended for live trading)
USE_SCHWAB_CAPITAL_IN_LIVE=true
# Risk threshold reduced to 2% (from 7%) per AI recommendation
BOT_RISK_THRESHOLD=0.02
# For conservative live start: BOT_MIN_ALLOCATION=50, BOT_MAX_ALLOCATION=200 (see LIVE_MODE_GUIDE.md)
BOT_MIN_ALLOCATION=100
BOT_MAX_ALLOCATION=5000
# Trailing stop tightened to 3% (from 5%) per AI recommendation
BOT_TRAILING_STOP_PERCENT=0.03
BOT_MAX_OPEN_POSITIONS=50
# Use margin (Settings > Trading). true = use total capital; false = settled capital only (T+1).
USE_MARGIN=false
BOT_MAX_CONSECUTIVE_LOSSES=3
# Position size reduced to 1% (from 5%) per AI recommendation
BOT_POSITION_SIZE=0.01
# Stop loss increased to 6% (from 5%) per AI recommendation
BOT_STOP_LOSS_PERCENT=0.06
# High sale percent (profit target) - formerly BOT_TAKE_PROFIT_PERCENT
# Defines the base percentage gain at which to take profits on positions
# Can be dynamically adjusted based on monthly target, T+1 settlement, and momentum
# Can also use BOT_TAKE_PROFIT_PERCENT for backward compatibility
# Default increased to 12% for profit-focused trading (was 10%)
HIGH_SALE_PERCENT=0.12

# Monthly Return Target
# Target monthly return percentage (e.g., 0.03 = 3% per month)
# Used for dynamic exit target calculation - bot adjusts profit targets based on progress
MONTHLY_RETURN_TARGET=0.03

# Enable Monthly Target Tracking
# When true, bot adjusts exit targets based on monthly return progress
ENABLE_MONTHLY_TARGET_TRACKING=true

# T+1 Settlement-Aware Exits
# When true, bot considers capital availability when deciding exit timing
ENABLE_SETTLEMENT_AWARE_EXITS=true
BOT_RISK_FREE_RATE=0.01
SCAN_SYMBOLS_FILE=scan_symbols.txt

# Short-Selling (Phase 1: margin/availability and concentration)
# Allow shorts in paper mode. Set 'false' to disable shorting in paper.
ALLOW_SHORTS_IN_PAPER=true
# Allow short orders in live/sandbox. Set 'false' if broker does not support or you want to disable.
SCHWAB_SHORT_SELLING_ENABLED=true
# Max concurrent short positions (default: same as BOT_MAX_OPEN_POSITIONS).
MAX_SHORT_POSITIONS=5
# Max short exposure as fraction of capital (default 0.25 = 25%).
MAX_SHORT_EXPOSURE_PCT=0.25

# Order Type Configuration
# Default order types for live trading mode
# Valid values: 'LIMIT' or 'MARKET'
# LIMIT orders: Execute only at specified price or better (good for price control on entries)
# MARKET orders: Execute immediately at current market price (good for quick exits)
# Recommended for swing trading: LIMIT for BUY, MARKET for SELL
# Default: LIMIT for BUY (price control), MARKET for SELL (faster execution)
BOT_DEFAULT_BUY_ORDER_TYPE=LIMIT
BOT_DEFAULT_SELL_ORDER_TYPE=MARKET
# Optional limit order price offset (0 = none). Opens: limit = price * (1 - offset); closes: limit = price * (1 + offset). Capped 0–5%.
LIMIT_ORDER_OFFSET_PCT=0
# Stop / stop-limit / trailing-stop (when BOT_DEFAULT_*_ORDER_TYPE is STOP, STOP_LIMIT, or TRAILING_STOP). Capped 0–10%.
STOP_OFFSET_PCT=0.01
STOP_LIMIT_OFFSET_PCT=0.01
# Trailing-stop order % (broker order type). Defaults to BOT_TRAILING_STOP_PERCENT if unset. Capped 1–15%.
TRAILING_STOP_ORDER_PCT=0.03
# Price source: 'realtime' (get_stock_price) vs 'last_close' (OHLCV last close when available)
PRICE_SOURCE=realtime
# Refresh price immediately before SELL/COVER and use for execution; false = use signal-time price
EXIT_REFRESH_PRICE=true

# Trading Frequency Configuration
# Number of seconds to wait between trades (2 = reduced frequency per AI recommendation)
TRADING_FREQUENCY=2

# Dynamic Trailing Stop Configuration
DYNAMIC_STOP_ENABLED=true
VOLATILITY_WINDOW=20
MIN_TRAILING_STOP=0.02
MAX_TRAILING_STOP=0.10

# ============================================================================
# 3. STOCK DISCOVERY & SELECTION (TOS-like Dynamic Screener)
# ============================================================================
# The bot uses ThinkOrSwim (TOS)-like dynamic stock discovery by default
# It automatically finds tradeable stocks based on your criteria below

# Enable Stock Screener (RECOMMENDED - TOS-like behavior)
# Set to 'true' for dynamic discovery from S&P 500, NASDAQ-100, S&P 400, Russell 1000, etc. (DEFAULT)
# Set to 'false' to use static scan_symbols.txt file instead
ENABLE_STOCK_SCREENER=true

# Stock Filtering Criteria (Applied During Discovery)
# These filters determine which stocks pass initial screening
# 
# Price Range
MIN_STOCK_PRICE=5.0              # Minimum price per share (avoid penny stocks)
MAX_STOCK_PRICE=1000.0           # Maximum price per share (allows most major stocks)
#   ⚠️  WARNING: MAX_STOCK_PRICE < 50 will likely result in 0 stocks found
#       Most liquid stocks are $50-$500+ (MSFT ~$420, AAPL ~$230, NVDA ~$500)
#
# Volume & Liquidity
MIN_DAILY_VOLUME=500000          # Minimum daily trading volume (ensures liquidity)
#   Recommended: 500,000 - 1,000,000 for most strategies
#
# Risk/Volatility
MAX_STOCK_VOLATILITY=0.15        # Maximum volatility (15% = moderate risk)
#   Recommended: 0.10 (conservative) to 0.20 (aggressive)

# Stock Scanning & Prioritization (TOS-like Ranking)
# Goal: ~3s to get ~200 filtered (like TOS), then sort. No early cutoff — fetch full pool, filter all, then sort.
#
# 1. Universe = Wikipedia (S&P 500, NASDAQ-100, S&P 400, Russell 1000, etc.) or fallback.
# 2. Phase 1 (batch): Fetch full scan pool in chunks via yf.download; filter by .env (price, vol, volatility).
# 3. Phase 2: Score remaining stocks (momentum, volume, liquidity, sentiment); return top N.
# 4. Trade up to MAX_DISCOVERED_STOCKS from the top-ranked list.
#
# Batch mode (SCREENER_USE_BATCH_FETCH=true): fetch full MAX_STOCKS_TO_SCAN, no early exit.
# Legacy (batch off): sequential fetch; scan pool capped by max(TOP*3, 50).
#
MAX_STOCKS_TO_SCAN=600           # Max symbols to fetch when building filtered universe (default 600; goal ~200 filtered)
TOP_STOCKS_TO_TRADE=50           # Max to return after sorting (default 50)
MAX_DISCOVERED_STOCKS=10         # Final number to actually trade
# Refresh symbol list every N trading cycles for "today's best" (0 = only at startup; 1 = every cycle)
# When > 0, bot keeps re-discovering so a hot stock 10 min from now can enter the pool. See docs/TODAYS_BEST_DISCOVERY.md
SYMBOL_REFRESH_INTERVAL_CYCLES=0
SCREENER_TARGET_FILTERED=200     # Reference: aim for ~200 filtered before sort (TOS-like). We fetch full pool; no early cutoff.
SCREENER_BATCH_SIZE=200          # Chunk size per yf.download call in batch mode
SCREENER_USE_BATCH_FETCH=true    # Use batch yf.download for Phase 1 (goal ~3s for ~200 filtered). Basic filter only; disable for sentiment/ML.

# Top Performers Feed (NEW - Live feed with auto-replacement, checked FIRST)
# Live feed of top performers with real-time price updates. Stocks are automatically replaced when performance drops.
# Bot checks this feed FIRST before watchlist/screener (roadmap idea #2).
ENABLE_TOP_PERFORMERS_FEED=true
TOP_PERFORMERS_FEED_SIZE=50              # Number of stocks in feed (default: 50)
TOP_PERFORMERS_FEED_UPDATE_INTERVAL=300  # Update interval in seconds (default: 300 = 5 minutes)
TOP_PERFORMERS_FEED_PERFORMANCE_WINDOW=3600  # Performance tracking window in seconds (default: 3600 = 1 hour)
TOP_PERFORMERS_FEED_REPLACEMENT_THRESHOLD=0.05  # Performance drop % to trigger replacement (default: 0.05 = 5%)

# Top Performers Watchlist (LEGACY - kept for backward compatibility)
# Stock Scoring Weights (TOS-like Prioritization)
# How stocks are ranked (weights must sum to ~1.0)
# Adjust these to match your trading strategy
SCORE_WEIGHT_MOMENTUM=0.3        # Price momentum strength
SCORE_WEIGHT_VOLUME=0.2          # Trading activity vs average
SCORE_WEIGHT_VOLATILITY=0.2      # Risk/opportunity balance (moderate preferred)
SCORE_WEIGHT_LIQUIDITY=0.15      # Market cap and ease of trading
SCORE_WEIGHT_SENTIMENT=0.15      # News sentiment (if enabled)

# Advanced Filtering (Optional - Requires Additional Setup)
# These features add extra layers of quality control
#
ENABLE_SENTIMENT_FILTER=false    # Filter by news sentiment (needs NEWS_API_KEY or FINNHUB_API_KEY)

# ML Signal Filter Configuration
# Enable ML-based signal filtering to improve win rate
# Requires scikit-learn to be installed
ENABLE_ML_SIGNAL_FILTER=true     # Enable ML signal filtering (requires trained model)
ML_SIGNAL_FILTER_MIN_CONFIDENCE=0.6   # Minimum confidence threshold (0.0-1.0)
ML_SIGNAL_FILTER_MIN_WIN_PROB=0.55    # Minimum win probability threshold (0.0-1.0)
ML_SIGNAL_FILTER_MODEL_TYPE=random_forest  # Model type: 'random_forest' or 'gradient_boosting'
# yfinance mode: if bot shows tickers but no trades, loosen one at a time (see docs/YFINANCE_LOOSEN_PARAMS.md):
# ENABLE_ML_SIGNAL_FILTER=false
# ML_SIGNAL_FILTER_MIN_CONFIDENCE=0.3
# ML_SIGNAL_FILTER_MIN_WIN_PROB=0.35
# STRATEGY_MIN_BARS=20
# Min OHLCV bars required for strategy signal (default 50; lower to 20–30 for yfinance testing)
STRATEGY_MIN_BARS=50
# Optional: timeout per symbol for get_strategy_signal (seconds; 0 = disabled). If set, slow symbols get reason "timeout" in Decision Report and loop continues.
# GET_STRATEGY_SIGNAL_TIMEOUT_SECONDS=0

# Prospects / Culling (No-trade symbols discarded so list becomes prospects only)
# Consecutive "No trade" cycles before removing a symbol from the scan list (0 = disable culling; default 3)
BOT_CULL_NO_TRADE_CYCLES=3
# If prospects list falls below this after culling, replenish from feed (default 5)
BOT_PROSPECTS_MIN_SIZE=5
# Max symbols when replenishing (default: MAX_DISCOVERED_STOCKS)
# BOT_PROSPECTS_REPLENISH_MAX=10

# Parallel batch size for get_strategy_signal (1–64; default 16). Higher = faster cycles, more CPU/network.
BOT_SIGNAL_BATCH_SIZE=16

# Restart recovery: if last cycle was within this many minutes, resume (restore symbols + no_trade_streak); else start fresh (default 30)
BOT_RECOVERY_WINDOW_MINUTES=30
# Path to bot state JSON file (default: project root / bot_state.json). Used to resume after connection loss.
# BOT_STATE_FILE=bot_state.json

# Portfolio Optimization Configuration
# Enable portfolio-optimized allocation instead of simple equal allocation
ENABLE_PORTFOLIO_OPTIMIZATION=true    # Use portfolio optimizer for position sizing
PORTFOLIO_OPTIMIZATION_METHOD=sharpe  # Method: 'sharpe', 'min_variance', 'risk_parity', or 'equal'

# Adaptive Learning Configuration
# Enable adaptive learning to improve strategy selection over time
ENABLE_ADAPTIVE_LEARNING=true          # Enable adaptive learning (Q-Learning, Multi-Armed Bandit)
ADAPTIVE_LEARNING_METHOD=qlearning    # Method: 'qlearning' or 'bandit'
ADAPTIVE_LEARNING_EXPLORATION=true    # Enable exploration (set false for production after learning)

# Real-Time ML Parameter Optimization Configuration
# Enable periodic ML parameter optimization during trading (not just at end)
ENABLE_REALTIME_ML_OPTIMIZATION=true   # Run ML optimization periodically during trading
ML_OPTIMIZATION_INTERVAL_TRADES=20     # Optimize every N trades (default: 20)
ML_OPTIMIZATION_INTERVAL_MINUTES=60    # Or every N minutes (default: 60)
ML_OPTIMIZATION_MIN_TRADES=10         # Minimum trades before first optimization (default: 10)

# Performance Optimization Configuration
# Caching and batching for improved efficiency
PORTFOLIO_OPTIMIZATION_CACHE_TTL=300   # Portfolio optimization cache TTL in seconds (default: 300 = 5 min)
ML_PREDICTION_CACHE_TTL=60              # ML prediction cache TTL in seconds (default: 60 = 1 min)
MIN_SENTIMENT_SCORE=0.0          # Minimum sentiment (-1 to 1, 0=neutral)
#
ENABLE_ML_FILTER=false           # Filter by ML signal quality (needs trained model)
MIN_ML_CONFIDENCE=0.6            # Minimum ML confidence (0-1)
MIN_ML_WIN_PROBABILITY=0.55      # Minimum predicted win rate (0-1)
#
ENABLE_PORTFOLIO_OPTIMIZATION=false  # Analyze diversification (needs scipy)
MIN_DIVERSIFICATION_SCORE=0.3    # Minimum portfolio diversity (0-1)

# Static Symbol File (Fallback - RARELY USED)
# Only used when ENABLE_STOCK_SCREENER=false
# Points to a text file with stock symbols (one per line)
SCAN_SYMBOLS_FILE=scan_symbols.txt

# Dynamic API Scanner (Advanced - RARELY USED)
# Optional: Fetch symbols from custom API endpoint
# Leave commented unless you have a specific API to use
# DYNAMIC_SCAN_API_URL=https://api.example.com/symbols

# ============================================================================

# Position Management Configuration
PARTIAL_EXIT_ENABLED=true
PARTIAL_EXIT_PERCENTAGE=0.5

# Paper Trading Simulation Settings
SIMULATED_WIN_RATE=0.7

# AI/ML Win Rate Auto-Tuning
# Target win rate for AI/ML auto-tuning (default: 70%)
# When actual win rate falls below this target (and >= 10 trades), 
# ML parameter optimization is triggered to improve performance
WIN_RATE_TARGET=0.70

# Volatility Normalization Settings
VOLATILITY_NORMALIZATION_MIN=0.01
VOLATILITY_NORMALIZATION_RANGE=0.19

# Capital Floor and PDT Configuration
CAPITAL_FLOOR_PERCENT=0.10

# Swing Trading Hold Period Enforcement
# WARNING: This setting affects trading behavior and regulatory compliance!
# Minimum number of days to hold a position before allowing a sell
# Set to 1 to enforce no same-day sells (swing trading strategy)
# Set to 0 to allow day trading (when PDT rules allow)
# Default: 1 (enforce minimum 24-hour hold)
SWING_MIN_HOLD_DAYS=1

# Alert Configuration
ENABLE_ALERTS=true
# Email alerts on/off (Settings > Alerts). When set, overrides ENABLE_ALERTS. false = no emails.
# For dev: keep false to avoid SMTP auth errors (Gmail App Password required when true)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL=operator@example.com
# Minimum alert severity to send emails (INFO, WARNING, CRITICAL)
# Only alerts at or above this level will be emailed
ALERT_MIN_SEVERITY=INFO

# SMTP Email Configuration (for email alerts)
# SMTP server hostname (e.g., smtp.example.com, smtp-mail.outlook.com, smtp.office365.com)
SMTP_SERVER=smtp.example.com
# SMTP server port (587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587
# Your email address (used as sender)
SMTP_USERNAME=operator@example.com
# Your email password or app-specific password
# For Gmail: Use app-specific password (https://support.google.com/accounts/answer/185833)
# For Outlook: Use regular password or app password if 2FA is enabled
SMTP_PASSWORD=change-me
# Use TLS encryption (recommended: true)
SMTP_USE_TLS=true
# Email sender name (appears in "From" field)
SMTP_FROM_NAME=Market Pie5 Bot
# Maximum retry attempts for failed email sends
SMTP_MAX_RETRIES=3
# Retry delay in seconds (exponential backoff applied)
SMTP_RETRY_DELAY=5

# Email Rate Limiting (prevents email spam)
EMAIL_RATE_LIMIT_ENABLED=true    # Enable rate limiting for emails
EMAIL_MAX_PER_HOUR=20            # Maximum emails per hour (0 = unlimited)
EMAIL_MIN_INTERVAL_SECONDS=60    # Minimum seconds between emails

# Web GUI Configuration
WEB_GUI_MAX_SYMBOLS=5
WEB_GUI_CONTINUOUS_TRADING=false
WEB_GUI_CYCLE_DELAY=5
WEB_GUI_DEBUG=false

# Copilot Debug Mode Configuration
# Enable detailed debug logging to help GitHub Copilot analyze bot behavior between runs
# When enabled, creates detailed JSONL log files in logs/copilot_debug_*.jsonl
# Logs include: initialization, decisions, trades, strategies, errors, state snapshots, and metrics
# Useful for troubleshooting and understanding bot decision-making process
# Set to 'true' to enable, 'false' to disable (default: false)
COPILOT_DEBUG_MODE=false

# Top Performers Watchlist Configuration
# Enable the top performers watchlist on the dashboard (shows best stocks to trade)
ENABLE_TOP_PERFORMERS_WATCHLIST=true
# Number of top performing stocks to display in watchlist (default: 50)
TOP_PERFORMERS_WATCHLIST_SIZE=50
# Auto-refresh interval for watchlist in seconds (default: 60)
TOP_PERFORMERS_REFRESH_INTERVAL=60
# Minimum stocks in universe before screening for top performers (default: 100)
TOP_PERFORMERS_MIN_UNIVERSE=100
# Startup delay before initializing watchlist to allow system stabilization (default: 5.0 seconds)
WATCHLIST_STARTUP_DELAY=5.0

# Stock Screener Performance Tuning
# Maximum number of stocks to check during screening (default: 100, reduced from 200 to prevent CPU spikes)
STOCK_SCREENER_MAX_CHECK=100
# Delay between individual stock fetches in seconds (default: 0.1)
# Increase this value to reduce CPU load during screening at the cost of slower screening
STOCK_FETCH_DELAY=0.1
# NOTE: ENABLE_SCREENER_TIMING is configured in the Stock Scanning section above (line 297)
# Do not duplicate this setting here

# User Profile Configuration
# These settings personalize the web GUI experience
USER_PROFILE_NAME=Trader
USER_PROFILE_USERNAME=@trader

# Resource Throttling Configuration (for Raspberry Pi 5 stability)
# Maximum CPU usage percentage before throttling kicks in (default: 75%)
BOT_MAX_CPU_PERCENT=75
# Maximum memory usage percentage before throttling kicks in (default: 75%)
BOT_MAX_MEMORY_PERCENT=75

# ============================================================================
# Email Service Configuration (SendGrid)
# ============================================================================
SENDGRID_API_KEY=change-me
FROM_EMAIL=operator@example.com
BASE_URL=https://market-pie5-bot.example.com

# ============================================================================
# CAPTCHA Configuration (Google reCAPTCHA v3)
# ============================================================================
RECAPTCHA_SECRET_KEY=change-me
RECAPTCHA_MIN_SCORE=0.5
# Maximum disk usage percentage before throttling kicks in (default: 90%)
BOT_MAX_DISK_PERCENT=90
# Maximum network throughput in MB/s before throttling kicks in (default: 100)
BOT_MAX_NETWORK_MBPS=100
# Throttle delay in seconds when resources exceed limits (default: 5)
BOT_THROTTLE_DELAY=5
# Enable/disable resource throttling (default: true for Pi5 stability)
BOT_ENABLE_THROTTLING=true

# Beta Features Configuration
# AI Auto-Tweak - Experimental feature that uses ML to automatically optimize trading parameters
# Set to 'true' to enable AI-based parameter optimization (requires HuggingFace API key)
# WARNING: This is a beta feature - always review suggested changes before applying
# Recommended: Keep as 'false' until you are comfortable with the feature
BOT_ENABLE_AI_AUTO_TWEAK=false

# ============================================================================
# Required for docker compose (also in env.required.example)
# ============================================================================
ENVIRONMENT=production
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DIRECTOR_USERNAME=director
DIRECTOR_PASSWORD=change-me
USER_USERNAME=user
USER_PASSWORD=change-me
BOT_API_KEY=change-me
